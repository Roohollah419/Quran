<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Surah Header (matches Surah List item style) -->
    <FrameLayout
        android:id="@+id/frameLayoutSurahHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Background frame image -->
        <ImageView
            android:id="@+id/ivSurahFrame"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:src="@drawable/luxury_frame"
            android:scaleType="fitXY"
            android:contentDescription="@string/app_name"/>

        <!-- Content layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <!-- Surah Number -->
            <TextView
                android:id="@+id/tvSurahNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.9"
                android:text="1"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary"
                android:textDirection="ltr"
                android:gravity="center"
                android:paddingEnd="8dp"
                android:paddingStart="8dp"/>

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="?android:attr/textColorSecondary"
                android:alpha="0.3"/>

            <!-- Surah Name -->
            <TextView
                android:id="@+id/tvSurahName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="@string/app_name"
                android:textSize="18sp"
                android:textColor="?android:attr/textColorPrimary"
                android:fontFamily="@font/uthmantaha"
                android:textDirection="rtl"
                android:gravity="center"
                android:paddingEnd="8dp"
                android:paddingStart="8dp"/>

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="?android:attr/textColorSecondary"
                android:alpha="0.3"/>

            <!-- Ayah Count -->
            <TextView
                android:id="@+id/tvSurahInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:text="7"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary"
                android:textDirection="ltr"
                android:gravity="center"
                android:paddingEnd="8dp"
                android:paddingStart="8dp"/>

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="?android:attr/textColorSecondary"
                android:alpha="0.3"/>

            <!-- Revelation Type -->
            <ImageView
                android:id="@+id/ivRevelationType"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="0.7"
                android:scaleType="centerInside"
                android:paddingEnd="8dp"
                android:paddingStart="8dp"
                android:contentDescription="@string/app_name"/>

        </LinearLayout>
    </FrameLayout>

    <!-- Audio Control Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/audioControlBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:padding="@dimen/padding_medium"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/frameLayoutSurahHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Play/Pause Button -->
        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_download"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/play"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Time Display (Current) -->
        <TextView
            android:id="@+id/tvCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginStart="@dimen/padding_small"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnPlayPause"/>

        <!-- SeekBar -->
        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_small"
            android:layout_marginEnd="@dimen/padding_small"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvCurrentTime"
            app:layout_constraintEnd_toStartOf="@id/tvTotalTime"/>

        <!-- Time Display (Total) -->
        <TextView
            android:id="@+id/tvTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginEnd="@dimen/padding_small"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnStop"/>

        <!-- Stop Button -->
        <ImageButton
            android:id="@+id/btnStop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/stop"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Container for RecyclerView and indicators -->
    <FrameLayout
        android:id="@+id/frameContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/audioControlBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Top overscroll indicator (behind RecyclerView) -->
        <TextView
            android:id="@+id/tvPreviousSurahIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="↑ Previous Surah"
            android:textSize="16sp"
            android:textColor="@color/primary"
            android:gravity="center"
            android:padding="16dp"
            android:layout_gravity="top"
            android:visibility="gone"/>

        <!-- Bottom overscroll indicator (behind RecyclerView) -->
        <TextView
            android:id="@+id/tvNextSurahIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="↓ Next Surah"
            android:textSize="16sp"
            android:textColor="@color/primary"
            android:gravity="center"
            android:padding="16dp"
            android:layout_gravity="bottom"
            android:visibility="gone"/>

        <!-- RecyclerView for Ayahs (on top, will be translated) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewAyahs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/padding_small"
            android:paddingBottom="80dp"
            android:clipToPadding="false"
            android:background="@color/background"/>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
