<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/padding_small"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:backgroundTint="@color/surface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_medium">

        <!-- Surah Number -->
        <TextView
            android:id="@+id/tvSurahNumber"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:background="@drawable/circle_background"
            tools:text="1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Surah Names -->
        <TextView
            android:id="@+id/tvSurahNameArabic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginStart="@dimen/padding_medium"
            tools:text="الفاتحة"
            app:layout_constraintTop_toTopOf="@id/tvSurahNumber"
            app:layout_constraintStart_toEndOf="@id/tvSurahNumber"
            app:layout_constraintEnd_toStartOf="@id/btnAction"/>

        <TextView
            android:id="@+id/tvSurahNameEnglish"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginStart="@dimen/padding_medium"
            tools:text="Al-Fatihah"
            app:layout_constraintTop_toBottomOf="@id/tvSurahNameArabic"
            app:layout_constraintStart_toEndOf="@id/tvSurahNumber"
            app:layout_constraintEnd_toStartOf="@id/btnAction"
            app:layout_constraintBottom_toBottomOf="@id/tvSurahNumber"/>

        <!-- Action Button (Download/Delete) -->
        <ImageButton
            android:id="@+id/btnAction"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_download"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/download"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Progress Bar (visible when downloading) -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="0dp"
            android:layout_height="4dp"
            style="?android:attr/progressBarStyleHorizontal"
            android:visibility="gone"
            android:layout_marginTop="@dimen/padding_small"
            app:layout_constraintTop_toBottomOf="@id/tvSurahNumber"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible"
            tools:progress="50"/>

        <!-- Download Info (visible when downloading or downloaded) -->
        <TextView
            android:id="@+id/tvDownloadInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            tools:text="2.5 MB"
            tools:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/progressBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
