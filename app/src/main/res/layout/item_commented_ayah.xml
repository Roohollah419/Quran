<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="0dp"
    android:layout_marginEnd="0dp"
    android:layout_marginTop="0dp"
    android:layout_marginBottom="0dp"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@android:color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="0dp"
        android:background="@android:color/transparent">

        <TextView
            android:id="@+id/tvBismillah"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ"
            android:textSize="24sp"
            android:gravity="center"
            android:layoutDirection="rtl"
            android:fontFamily="@font/uthmantaha"
            android:textDirection="rtl"
            android:visibility="gone"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvAyahArabic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Arabic Text"
            android:textSize="20sp"
            android:gravity="start"
            android:layoutDirection="rtl"
            android:fontFamily="@font/uthmantaha"
            android:textDirection="rtl"
            android:lineSpacingExtra="2dp"
            app:layout_constraintTop_toBottomOf="@id/tvBismillah"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvAyahTranslation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Translation Text"
            android:textSize="16sp"
            android:gravity="start"
            android:textDirection="ltr"
            android:lineSpacingExtra="0dp"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@id/tvAyahArabic"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvAyahAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Surah Name - Ayah 1"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="start"
            android:textStyle="italic"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvAyahTranslation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Comment Section -->
        <LinearLayout
            android:id="@+id/layoutComment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/comment_text_background"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvAyahAddress"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvCommentText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Comment text goes here"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textStyle="italic"
                android:lineSpacingExtra="2dp"/>

            <ImageView
                android:id="@+id/ivEdit"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_edit"
                android:contentDescription="Edit comment"
                android:padding="2dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"/>

            <ImageView
                android:id="@+id/ivDelete"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_delete"
                android:contentDescription="Delete comment"
                android:padding="2dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

        <View
            android:id="@+id/bottomBorder"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="?android:attr/textColorSecondary"
            android:alpha="0.2"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/layoutComment"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
